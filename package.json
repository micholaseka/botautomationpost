{
  "name": "botautopost",
  "version": "1.0.2",
  "description": "Aplikasi desktop untuk membantu membuat listing Facebook Marketplace.",
  "main": "desktop/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "prepare:chromium": "node scripts/prepare-chromium.mjs",
    "build": "electron-builder --publish never",
    "dist:win": "npm run prepare:chromium && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run prepare:chromium && electron-builder --linux deb rpm --x64 --publish never"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.micholaseka.botautopost",
    "productName": "Marketplace AutoPost Bot",
    "executableName": "MarketplaceAutoPostBot",
    "asar": true,
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/playwright/**",
      "node_modules/playwright-core/**"
    ],
    "extraResources": [
      {
        "from": "vendor/chromium",
        "to": "chromium"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Marketplace AutoPost Bot",
      "artifactName": "${executableName}-Setup-${version}.${ext}"
    }
  }
}
